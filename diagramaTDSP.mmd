flowchart TD
    %% Definição de Estilos
    classDef stage fill:#f0f4f8,stroke:#2c3e50,stroke-width:2px,color:#2c3e50;
    classDef process fill:#ffffff,stroke:#3498db,stroke-width:1px;
    classDef artifact fill:#e8f5e9,stroke:#27ae60,stroke-width:2px,stroke-dasharray: 5 5;
    classDef decision fill:#fff3cd,stroke:#f1c40f,stroke-width:2px,shape:rhombus;

    %% STAGE 1: BUSINESS UNDERSTANDING
    subgraph Stage1 [Stage 1: Business Understanding]
        direction TB
        BU1["Objetivo: Automatizar Triagem de Vinhos"]
        BU2["Critério: Maximizar Precision<br/>(Minimizar Risco Reputacional)"]
        BU1 --> BU2
    end

    %% STAGE 2: DATA ACQUISITION
    subgraph Stage2 [Stage 2: Data Acquisition & Understanding]
        direction TB
        DA1[("Dataset:<br/>winequality-red.csv")]
        DA2["EDA & Data Health"]
        DA3{"Decisão de Engenharia:<br/>Problema de Regressão?"}

        DA1 --> DA2 --> DA3
        DA3 -- "Não (Escassez de Dados)" --> DA4["Transformação:<br/>Classificação Binária<br/>(Premium >= 7)"]
    end

    %% STAGE 3: MODELING
    subgraph Stage3 [Stage 3: Modeling]
        direction TB
        MO1["Feature Engineering:<br/>StandardScaler"]
        MO2["Treino: Random Forest<br/>(Cost-Sensitive / Balanced)"]
        MO3["Avaliação:<br/>Matriz de Confusão"]
        MO4[("Artefatos Serializados:<br/>model_rf.pkl<br/>scaler.pkl")]

        MO1 --> MO2 --> MO3
    end

    %% STAGE 4: DEPLOYMENT
    subgraph Stage4 [Stage 4: Deployment]
        direction TB
        DE1["API Microserviço<br/>(FastAPI + Pydantic)"]
        DE2["Containerização<br/>(Docker)"]
        DE3["Sistema de Monitorização<br/>(Logs de Data Drift)"]

        DE1 --> DE2 --> DE3
    end

    %% STAGE 5: CUSTOMER ACCEPTANCE
    subgraph Stage5 [Stage 5: Customer Acceptance]
        direction TB
        CA1["Validação de Negócio:<br/>Precision 93% na Classe Premium"]
        CA2["Aprovação Final:<br/>Modelo Híbrido 'Humano-no-Comando'"]
    end

    %% Ligações entre Estágios
    Stage1 --> Stage2
    DA4 --> Stage3
    MO3 -- Aprovado --> MO4
    MO4 --> Stage4
    Stage4 --> Stage5

    %% Aplicação de Estilos
    class Stage1,Stage2,Stage3,Stage4,Stage5 stage;
    class BU1,BU2,DA2,DA4,MO1,MO2,MO3,DE1,DE2,DE3,CA1,CA2 process;
    class DA1,MO4 artifact;
    class DA3 decision;